# Salin file ini menjadi .env jika ingin menyesuaikan profil model
# Pilihan ACTIVE_MODEL_PROFILE:
# 1. clip-fast      -> sentence-transformers/clip-ViT-B-32 (Base Multimodal Model)
# 2. clip-finetuned -> ./models/clip-ecommerce-finetuned (Custom Finetuned Model)
ACTIVE_MODEL_PROFILE=clip-fast
ENABLE_RERANKER=True
